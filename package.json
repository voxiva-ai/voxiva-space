{
  "name": "voxiva-space",
  "productName": "Voxiva Space",
  "description": "A desktop workspace for terminals, coding agents, files, and browser previews.",
  "author": "Voxiva AI",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "electron:pilot": "electron electron/pilot-main.cjs",
    "electron:smoke": "electron electron/pilot-main.cjs --smoke",
    "electron:app": "npm run build && cargo build --manifest-path native/Cargo.toml && electron electron/main.cjs",
    "electron:app-smoke": "electron electron/main.cjs --smoke",
    "electron:pack": "npm run build && cargo build --release --manifest-path native/Cargo.toml && electron-builder --dir",
    "electron:dist": "npm run build && cargo build --release --manifest-path native/Cargo.toml && electron-builder",
    "test:electron-files": "node electron/files.test.cjs",
    "test:electron-pilot": "node electron/pilot-bounds.test.cjs",
    "test:electron-visibility": "node electron/view-visibility.test.cjs",
    "test:electron-vscode": "node electron/vscode.test.cjs",
    "test:electron-vault": "node electron/vault.test.cjs",
    "test:electron-companion": "node electron/companion.test.cjs",
    "test:electron-cookies": "node electron/cookies.test.cjs",
    "test:electron-updates": "node electron/updates.test.cjs",
    "dev": "node scripts/tauri-dev.mjs",
    "dev:kill": "node -e \"import('./scripts/dev-port.mjs').then(m=>{m.killStaleVoxiva();m.killPort(1422);console.log('[dev:kill] port 1422 cleared')})\"",
    "dev:web": "node scripts/web-dev.mjs",
    "web:dev": "node scripts/web-dev.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@untitledui/icons": "^0.0.22",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.9",
    "material-icon-theme": "^5.37.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "ai.voxiva.space",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Voxiva-Space-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "src-tauri/src/inspector/inject.js", "package.json"],
    "win": { "target": "nsis", "icon": "src-tauri/icons/icon.ico", "extraResources": [{ "from": "native/target/release/voxiva-backend.exe", "to": "voxiva-backend.exe" }] },
    "mac": { "target": ["dmg", "zip"], "icon": "src-tauri/icons/icon.icns", "extraResources": [{ "from": "native/target/release/voxiva-backend", "to": "voxiva-backend" }] },
    "publish": [{ "provider": "github", "owner": "voxiva-ai", "repo": "voxiva-space" }]
  }
}
