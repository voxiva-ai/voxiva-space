{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxiva Space",
  "version": "0.2.4",
  "identifier": "ai.voxiva.space",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voxiva Space",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Voxiva",
    "copyright": "Copyright © Voxiva",
    "category": "DeveloperTool",
    "shortDescription": "Voxiva Space",
    "longDescription": "Desktop workspace for terminals, files, and AI agents.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "Voxiva"
      }
    }
  }
}
